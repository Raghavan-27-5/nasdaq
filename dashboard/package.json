{
  "name": "nasdaq-ai-quant-terminal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Institutional research terminal frontend for the Nasdaq AI Quant Research System (Phase 11 / Gate 9).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "serve": "vite preview --port 4173 --host",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false --pretty",
    "gen:data": "python3 scripts/gen_demo_data.py"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/jetbrains-mono": "^5.1.1",
    "clsx": "^2.1.1",
    "echarts": "^5.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
